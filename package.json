{
  "name": "opencast",
  "private": true,
  "version": "0.1.0",
  "description": "An open-source, Raycast-style launcher for macOS. Bring your own AI keys, self-host your sync.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@opencast/sync-worker run build",
    "build:app": "./scripts/build-app.sh",
    "build:dmg": "./scripts/build-dmg.sh",
    "release:mac": "./scripts/release-macos.sh",
    "dev": "./scripts/dev.sh",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint"
  }
}
