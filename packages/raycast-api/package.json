{
  "name": "@opencast/raycast-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean-room runtime that provides the `@raycast/api` module to Raycast extensions running inside OpenCast.",
  "scripts": {
    "build": "node ./build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-reconciler": "0.34.0"
  },
  "devDependencies": {
    "@opencast/protocol": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.34.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "main": "./dist/runtime.cjs",
  "types": "./dist/index.d.ts"
}
